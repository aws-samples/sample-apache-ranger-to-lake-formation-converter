<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Log directory. Defaults to "logs" (relative to the working dir; /app/logs in the
        container image). Override with -Dlog.dir=/path or the LOG_DIR env var.
    -->
    <property name="LOG_DIR" value="${log.dir:-${LOG_DIR:-logs}}"/>

    <!-- STDOUT appender: all log levels in structured JSON format.
         Kept so container platforms (Apollo/ECS) that capture stdout keep working. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
                <jsonFormatter class="ch.qos.logback.contrib.jackson.JacksonJsonFormatter"/>
                <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampFormat>
                <appendLineSeparator>true</appendLineSeparator>
            </layout>
        </encoder>
    </appender>

    <!-- STDERR appender: ERROR level only in structured JSON format -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
                <jsonFormatter class="ch.qos.logback.contrib.jackson.JacksonJsonFormatter"/>
                <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampFormat>
                <appendLineSeparator>true</appendLineSeparator>
            </layout>
        </encoder>
    </appender>

    <!--
        Rolling file appender: bounded on-disk log for deployments that run the JAR directly
        rather than capturing stdout. Consume this file instead of redirecting stdout to a file
        (a shell "> app.log" redirect is NOT rotated and grows unbounded — that is what filled
        the disk with a 25 GB file during an hour-long simulator run).

        A fixed window of 10 archives, not a time window. The previous
        SizeAndTimeBasedRollingPolicy expressed maxHistory in DAYS, so a chatty run rolled many
        times per day and every one of those files was retained inside the 7-day window —
        258 files accumulated. maxIndex caps the file COUNT outright, so the worst case is
        bounded at maxFileSize * (maxIndex + 1).
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/ranger-lf-sync.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_DIR}/ranger-lf-sync.%i.log.gz</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>10</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>50MB</maxFileSize>
        </triggeringPolicy>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
                <jsonFormatter class="ch.qos.logback.contrib.jackson.JacksonJsonFormatter"/>
                <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampFormat>
                <appendLineSeparator>true</appendLineSeparator>
            </layout>
        </encoder>
    </appender>

    <!-- Root logger at INFO (overridden at runtime by ServerConfig.logLevel) -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="STDERR"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
